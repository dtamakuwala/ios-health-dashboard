<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dtamakuwala.ios-health-dashboard-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/drew.tamakuwala/Code/ios-health-dashboard/scripts/daily_refresh.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/drew.tamakuwala/Code/ios-health-dashboard</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>6</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/drew.tamakuwala/Code/ios-health-dashboard/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/drew.tamakuwala/Code/ios-health-dashboard/logs/launchd.err.log</string>

